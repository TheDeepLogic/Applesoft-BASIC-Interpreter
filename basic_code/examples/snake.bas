1 REM SNAKE - PLAYABLE GR MODE DEMO
2 REM ARROWS OR WASD STEER. ENTER STARTS. ESC OR Q QUITS.
10 HGR: POKE -16302,0
20 HCOLOR = 3: HPLOT 8,8 TO 271,8: HPLOT 271,8 TO 271,183: HPLOT 271,183 TO 8,183: HPLOT 8,183 TO 8,8
30 HCOLOR = 3: HPLOT 26,25 TO 52,25: HPLOT 26,25 TO 26,43: HPLOT 26,43 TO 52,43: HPLOT 52,43 TO 52,61: HPLOT 52,61 TO 26,61
40 HPLOT 65,61 TO 65,25: HPLOT 65,25 TO 91,61: HPLOT 91,61 TO 91,25
50 HPLOT 104,61 TO 117,25: HPLOT 117,25 TO 130,61: HPLOT 109,46 TO 125,46
60 HPLOT 143,25 TO 143,61: HPLOT 143,43 TO 169,25: HPLOT 143,43 TO 169,61
70 HPLOT 182,25 TO 182,61: HPLOT 182,25 TO 208,25: HPLOT 182,43 TO 204,43: HPLOT 182,61 TO 208,61
80 HCOLOR = 2: PX = 42: PY = 112
90 FOR X = 47 TO 202 STEP 5: NX = X: NY = 112 + INT(24 * SIN((X - 42) / 23)): HPLOT PX,PY TO NX,NY: PX = NX: PY = NY: NEXT X
100 PX = 42: PY = 120
110 FOR X = 47 TO 202 STEP 5: NX = X: NY = 120 + INT(24 * SIN((X - 42) / 23)): HPLOT PX,PY TO NX,NY: PX = NX: PY = NY: NEXT X
120 HCOLOR = 3: HPLOT 202,99 TO 235,116: HPLOT 235,116 TO 202,133: HPLOT 202,133 TO 202,99
130 HCOLOR = 2: HPLOT 211,109 TO 215,109: HPLOT 211,123 TO 215,123
140 HCOLOR = 3: HPLOT 235,116 TO 251,108: HPLOT 235,116 TO 251,124
150 HCOLOR = 3: HPLOT 80,151 TO 80,173: HPLOT 80,151 TO 98,151: HPLOT 80,162 TO 95,162: HPLOT 80,173 TO 98,173
160 HPLOT 108,173 TO 108,151: HPLOT 108,151 TO 126,173: HPLOT 126,173 TO 126,151
170 HPLOT 136,151 TO 158,151: HPLOT 147,151 TO 147,173
175 HPLOT 168,151 TO 168,173: HPLOT 168,151 TO 186,151: HPLOT 168,162 TO 183,162: HPLOT 168,173 TO 186,173
180 HPLOT 196,173 TO 196,151: HPLOT 196,151 TO 214,151: HPLOT 214,151 TO 214,162: HPLOT 196,162 TO 214,162: HPLOT 204,162 TO 218,173
185 P = 0: IF PEEK(-16384) > 127 THEN P = PEEK(-16384) - 128: POKE -16368,0
190 IF P <> 13 THEN 185
200 DIM SX(80),SY(80),AX(80),AY(80)
205 GOSUB 6000
210 SC = 0: LI = 3: LV = 1
220 GOSUB 1000
230 IF LI > 0 THEN 220
240 GOSUB 5000
250 END
990 REM
1000 REM START ONE LIFE
1010 LN = 4: DI = 1: AP = 3 + LV * 2
1020 SX(1) = 20: SY(1) = 25
1030 SX(2) = 19: SY(2) = 25
1040 SX(3) = 18: SY(3) = 25
1050 SX(4) = 17: SY(4) = 25
1060 GOSUB 2000
1070 GOSUB 2500
1080 GOSUB 3000
1085 GOSUB 4800
1090 GOSUB 3500
1100 RETURN
1990 REM
2000 REM DRAW PLAYFIELD
2010 GR
2020 COLOR = 1
2030 HLIN 0,39 AT 0: HLIN 0,39 AT 39
2040 VLIN 0,39 AT 0: VLIN 0,39 AT 39
2050 COLOR = 6
2060 HLIN 1,38 AT 1: HLIN 1,38 AT 38
2070 VLIN 1,38 AT 1: VLIN 1,38 AT 38
2080 RETURN
2490 REM
2500 REM PLACE APPLES
2510 FOR AI = 1 TO AP
2520 AX(AI) = 3 + AI * 5 + LV * 3 - INT((AI * 5 + LV * 3) / 34) * 34
2530 AY(AI) = 4 + AI * 7 + LV * 5 - INT((AI * 7 + LV * 5) / 33) * 33
2540 NEXT AI
2610 RETURN
2990 REM
3000 REM DRAW SNAKE AND APPLES
3010 COLOR = 13
3020 FOR AI = 1 TO AP
3030 PLOT AX(AI),AY(AI)
3040 NEXT AI
3050 COLOR = 3
3060 FOR SI = LN TO 2 STEP -1
3070 PLOT SX(SI),SY(SI)
3080 NEXT SI
3090 COLOR = 15: PLOT SX(1),SY(1)
3100 RETURN
3490 REM
3500 REM PLAY LOOP
3510 GOSUB 4000
3520 IF QU = 1 THEN LI = 0: RETURN
3530 GOSUB 4100
3540 GOSUB 4200
3550 IF DE = 1 THEN GOSUB 4600: RETURN
3560 GOSUB 4300
3570 GOSUB 4400
3580 IF AP = 0 THEN GOSUB 4700
3590 FOR TI = 1 TO 100: NEXT TI
3600 GOTO 3510
3990 REM
4000 REM READ KEYS
4010 QU = 0: P = 0
4020 IF PEEK(-16384) > 127 THEN P = PEEK(-16384) - 128: POKE -16368,0
4030 IF P = 81 OR P = 27 OR P = 155 THEN QU = 1
4040 IF P = 8 OR P = 65 THEN IF DI <> 1 THEN DI = 3
4050 IF P = 21 OR P = 68 THEN IF DI <> 3 THEN DI = 1
4060 IF P = 11 OR P = 87 THEN IF DI <> 4 THEN DI = 2
4070 IF P = 10 OR P = 83 THEN IF DI <> 2 THEN DI = 4
4080 RETURN
4090 REM
4100 REM CALCULATE NEW HEAD
4110 NX = SX(1): NY = SY(1)
4120 IF DI = 1 THEN NX = NX + 1
4130 IF DI = 2 THEN NY = NY - 1
4140 IF DI = 3 THEN NX = NX - 1
4150 IF DI = 4 THEN NY = NY + 1
4160 RETURN
4190 REM
4200 REM TEST WALL AND TAIL COLLISION
4210 DE = 0
4220 IF NX < 2 OR NX > 37 OR NY < 2 OR NY > 37 THEN DE = 1: RETURN
4230 FOR CI = 2 TO LN
4240 IF NX = SX(CI) AND NY = SY(CI) THEN DE = 1: RETURN
4250 NEXT CI
4260 RETURN
4290 REM
4300 REM MOVE OR GROW
4310 EA = 0
4320 FOR AI = 1 TO AP
4330 IF NX = AX(AI) AND NY = AY(AI) THEN EA = AI
4340 NEXT AI
4350 IF EA = 0 THEN 4360
4352 EX = AX(EA): EY = AY(EA): LN = LN + 1: SC = SC + 10
4354 FOR AI = EA TO AP - 1
4356 AX(AI) = AX(AI + 1): AY(AI) = AY(AI + 1)
4357 NEXT AI
4358 AP = AP - 1: COLOR = 0: PLOT EX,EY: GOSUB 4800
4360 IF EA = 0 THEN COLOR = 0: PLOT SX(LN),SY(LN)
4370 FOR SI = LN TO 2 STEP -1
4380 SX(SI) = SX(SI - 1): SY(SI) = SY(SI - 1)
4390 NEXT SI
4392 SX(1) = NX: SY(1) = NY
4394 REM EATEN APPLE WAS CLEARED AT 4358
4396 RETURN
4490 REM
4400 REM DRAW NEW HEAD
4410 COLOR = 3: PLOT SX(2),SY(2)
4420 COLOR = 15: PLOT SX(1),SY(1)
4430 RETURN
4590 REM
4600 REM LOSE LIFE
4610 POKE 0,90: POKE 1,8: CALL 768: POKE 0,150: POKE 1,14: CALL 768
4620 LI = LI - 1
4630 IF LI = 0 THEN RETURN
4640 GOSUB 4800
4650 GOTO 1010
4690 REM
4700 REM CLEAR LEVEL
4710 POKE 0,150: POKE 1,7: CALL 768: POKE 0,110: POKE 1,7: CALL 768: POKE 0,75: POKE 1,14: CALL 768
4720 SC = SC + 50: LV = LV + 1
4730 GOSUB 4800
4740 GOTO 1010
4790 REM
4800 REM STATUS STRIP
4810 VTAB 21: CALL -868: HTAB 2: PRINT "LIVES:";LI;"  SCORE:";SC;"  LEVEL:";LV;
4820 VTAB 22: CALL -868: HTAB 2: PRINT "APPLES LEFT:";AP
4830 VTAB 23: CALL -868: HTAB 2: PRINT "ARROWS/WASD STEER  Q OR ESC QUITS"
4930 RETURN
4990 REM
5000 REM GAME OVER
5010 TEXT: HOME
5020 PRINT "========================================"
5030 PRINT
5040 PRINT "              GAME OVER"
5050 PRINT
5060 PRINT "SCORE: ";SC
5070 PRINT "LEVEL: ";LV
5080 PRINT
5090 PRINT "PRESS RUN TO PLAY AGAIN"
5100 PRINT "========================================"
5110 RETURN
