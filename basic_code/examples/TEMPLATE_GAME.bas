1 REM NEON MAZE RUN
2 REM
3 REM A playable Applesoft dot maze with a graphical title splash,
4 REM collision-triggered tunnel warps, and ESC to quit.
5 REM
10 HOME
20 GOSUB 1000
30 GOSUB 2000
40 GOSUB 3000
45 GOSUB 3800
46 IF ST <> 0 THEN 45
50 GOSUB 5000
60 END
70 REM
1000 REM GRAPHICAL TITLE SPLASH
1010 GR
1020 FOR R = 0 TO 10
1030 COLOR = R + 1
1040 HLIN R,39 - R AT R
1050 HLIN R,39 - R AT 47 - R
1060 VLIN R,47 - R AT R
1070 VLIN R,47 - R AT 39 - R
1080 NEXT R
1090 COLOR = 15
1100 PLOT 19,23: PLOT 20,23: PLOT 19,24: PLOT 20,24
1110 COLOR = 13
1120 PLOT 14,18: PLOT 25,18: PLOT 14,29: PLOT 25,29
1130 COLOR = 6
1140 PLOT 11,21: PLOT 28,21: PLOT 11,26: PLOT 28,26
1150 SOUND 784,12: SOUND 988,12
1160 FOR T = 1 TO 800: NEXT T
1170 RETURN
1180 REM
2000 REM TITLE CARD
2010 TEXT
2020 HOME
2030 PRINT "========================================"
2040 PRINT
2050 HTAB 11: PRINT "NEON MAZE RUN"
2060 HTAB 6: PRINT "A PLAYABLE APPLESOFT SCENE"
2070 PRINT
2080 PRINT "ARROWS MOVE THE DOT THROUGH"
2090 PRINT "A NEON MAZE."
2100 PRINT
2110 PRINT "TOUCH A YELLOW DOT TO TRIGGER"
2120 PRINT "A TUNNEL WARP AND RELOCATE."
2140 PRINT "THE DOT DRIFTS UNTIL YOU STEER IT."
2150 PRINT "PRESS ESC ANY TIME TO EXIT."
2160 PRINT
2170 PRINT "========================================"
2180 FOR T = 1 TO 4000: NEXT T
2190 RETURN
3000 REM GAME SETUP
3010 DIM SX(4),SY(4)
3020 ST = 1
3030 GOSUB 3200
3040 PX = 18: PY = 38
3050 DIR = 1
3060 SX(1) = 3:  SY(1) = 44
3070 SX(2) = 11: SY(2) = 7
3080 SX(3) = 20: SY(3) = 23
3090 SX(4) = 28: SY(4) = 35
3100 WARP = 1
3110 GOSUB 3600
3120 RETURN
3200 REM DRAW MAZE AND DOTS
3210 GR
3220 COLOR = 1
3230 HLIN 0,39 AT 0: HLIN 0,39 AT 47
3240 VLIN 0,47 AT 0: VLIN 0,47 AT 39
3250 COLOR = 6
3260 HLIN 2,37 AT 2: HLIN 2,37 AT 45
3270 VLIN 2,45 AT 2: VLIN 2,45 AT 37
3280 COLOR = 4
3290 HLIN 4,28 AT 8: HLIN 10,38 AT 16
3300 HLIN 2,22 AT 24: HLIN 16,38 AT 32
3310 VLIN 4,22 AT 8: VLIN 12,38 AT 18
3320 VLIN 0,14 AT 28: VLIN 18,44 AT 32
3330 COLOR = 13
3340 PLOT 9,7: PLOT 27,15: PLOT 17,23: PLOT 33,35
3350 RETURN
3360 REM
3400 REM ERASE PLAYER
3410 COLOR = 0
3420 PLOT PX,PY
3450 RETURN
3460 REM
3600 REM DRAW PLAYER
3610 COLOR = 15
3620 PLOT PX,PY
3650 RETURN
3660 REM
3700 REM WAIT A TICK AND READ KEY
3710 P = 0: IF PEEK(-16384) > 127 THEN P = PEEK(-16384) - 128: POKE -16368,0
3720 K = PEEK(-16384)
3730 IF K = 81 OR K = 27 OR K = 155 THEN ST = 0
3750 RETURN
3760 REM
3800 REM ONE FRAME OF PLAY
3810 GOSUB 3700
3820 IF ST = 0 THEN RETURN
3830 DX = 0: DY = 0
3840 IF K = 8 OR K = 65 THEN DX = -1
3850 IF K = 21 OR K = 68 THEN DX = 1
3860 IF K = 11 OR K = 87 THEN DY = -1
3870 IF K = 10 OR K = 83 THEN DY = 1
3880 IF DX = 0 AND DY = 0 THEN 3940
3890 NX = PX + DX: NY = PY + DY
3900 IF NX < 1 OR NX > 38 OR NY < 1 OR NY > 46 THEN 3940
3910 C = SCRN(NX,NY)
3920 PX = NX: PY = NY: GOSUB 3600
3930 IF C = 13 THEN GOSUB 4000
3940 FOR W = 1 TO 10: NEXT W
3950 RETURN
3970 REM
4000 REM COLLISION WARP
4010 FOR TW = 1 TO 2
4015 GOSUB 4300
4017 NEXT TW
4020 WARP = WARP + 1
4030 IF WARP > 4 THEN WARP = 1
4040 GOSUB 3200
4050 PX = SX(WARP)
4060 PY = SY(WARP)
4070 GOSUB 3600
4080 SOUND 523,18
4090 RETURN
4100 REM
4200 REM CALCULATE NEXT STEP
4210 IF DIR = 1 THEN NX = PX + 1: NY = PY
4220 IF DIR = 2 THEN NX = PX: NY = PY - 1
4230 IF DIR = 3 THEN NX = PX - 1: NY = PY
4240 IF DIR = 4 THEN NX = PX: NY = PY + 1
4250 RETURN
4280 REM
4300 REM TUNNEL EFFECT
4310 GR
4320 FOR F = 0 TO 11
4330 GOSUB 4500
4340 FOR TD = 1 TO 120: NEXT TD
4350 NEXT F
4360 FOR F = 11 TO 0 STEP -1
4370 GOSUB 4500
4380 FOR TD = 1 TO 120: NEXT TD
4390 NEXT F
4400 SOUND 784,8: SOUND 988,8: SOUND 1318,16
4410 RETURN
4420 REM
4500 COLOR = F + 1
4510 HLIN F,39 - F AT F
4520 HLIN F,39 - F AT 47 - F
4530 VLIN F,47 - F AT F
4540 VLIN F,47 - F AT 39 - F
4550 HLIN F,39 - F AT 23 - F / 2
4560 HLIN F,39 - F AT 24 + F / 2
4570 PLOT 19 - F / 2,23 - F / 2
4580 PLOT 20 + F / 2,24 + F / 2
4590 RETURN
4450 REM
4700 REM RESTART SCENE AFTER WARP
4710 RETURN
4720 REM
5000 REM ENDING SCREEN
5010 TEXT
5020 HOME
5030 PRINT "========================================"
5040 PRINT
5050 HTAB 10: PRINT "THE EXIT OPENS"
5060 PRINT
5070 PRINT "THE DOT LEAVES THE MAZE"
5080 PRINT "AS THE CITY LIGHTS FADE."
5090 PRINT
5100 PRINT "THANKS FOR PLAYING."
5110 PRINT
5120 PRINT "PRESS RUN AGAIN TO RESTART."
5130 PRINT
5140 PRINT "========================================"
5150 FOR T = 1 TO 1000: NEXT T
5160 RETURN
