1 REM TEMPLATE GAME - START HERE
2 REM
3 REM This is a minimal game template showing proper Applesoft BASIC structure
4 REM for developing Apple II games using the applesoft.py emulator.
5 REM
6 REM VARIABLE KEY:
7 REM   ST = game state (0=menu, 1=playing, 2=won, 3=lost)
8 REM   LN = location number (0-5)
9 REM   SC = score or counter
10 REM   P1-P5 = puzzle solved flags (0=no, 1=yes)
11 REM   X$ = temporary string input
12 REM   I = temporary integer
13 REM
14 REM STRUCTURE:
15 REM   10-95    = Initialization
16 REM   100-250  = Main game loop
17 REM   500-650  = Command processing
18 REM   1000+    = Location displays
19 REM   2000+    = NPC/object interactions
20 REM   5000+    = Game state displays
21 REM   8000+    = Win/lose/end
22 REM
23 REM START CODING BELOW THIS LINE
24 REM ============================
25 REM
30 HOME
35 TEXT
40 REM Initialize all variables
45 ST = 1
50 LN = 0
55 SC = 0
60 P1 = 0
65 P2 = 0
70 P3 = 0
75 REM
80 REM Show intro and start game
85 GOSUB 2000
90 GOSUB 100
95 END
100 REM MAIN GAME LOOP
105 REM
110 GOSUB 500
115 IF ST = 2 THEN GOSUB 8000
120 IF ST = 3 THEN GOSUB 8100
125 IF ST <> 1 THEN END
130 GOTO 110
135 REM
500 REM COMMAND PROCESSING
510 GOSUB 1000
520 PRINT "COMMAND? ";
530 INPUT CMD$
540 CMD$ = LEFT$ (CMD$, 1)
545 REM
550 IF CMD$ = "Q" THEN ST = 3: RETURN
560 IF CMD$ = "H" THEN GOSUB 5000: RETURN
570 IF CMD$ = "S" THEN PRINT "SCORE: ";SC: INPUT "Y: ";X$: RETURN
575 REM Add more commands here
580 PRINT "?"
590 INPUT "Y: ";X$
600 RETURN
605 REM
1000 REM SHOW CURRENT LOCATION
1010 HOME
1020 IF LN = 0 THEN GOSUB 1100: RETURN
1030 IF LN = 1 THEN GOSUB 1200: RETURN
1035 REM
1100 REM LOCATION 0: START
1110 PRINT "=START="
1120 PRINT "YOU ARE HERE."
1130 PRINT ""
1140 PRINT "EXITS: E(EXPLORE)"
1150 PRINT ""
1160 RETURN
1165 REM
1200 REM LOCATION 1: EXPLORE
1210 PRINT "=EXPLORE="
1220 PRINT "YOU ARE EXPLORING."
1230 PRINT ""
1240 PRINT "EXITS: W(WEST)"
1250 PRINT ""
1260 RETURN
1265 REM
2000 REM SHOW INTRO
2010 HOME
2020 PRINT "GAME TEMPLATE"
2030 PRINT ""
2040 PRINT "THIS IS THE"
2050 PRINT "INTRODUCTORY"
2060 PRINT "MESSAGE."
2070 PRINT ""
2080 PRINT "PRESS ENTER"
2090 PRINT "TO BEGIN"
2100 INPUT "> ";X$
2110 HOME
2120 RETURN
2125 REM
5000 REM SHOW HELP
5010 HOME
5020 PRINT "=HELP="
5030 PRINT ""
5040 PRINT "COMMANDS:"
5050 PRINT " E(XPL)ORE"
5060 PRINT " S(CORE)"
5070 PRINT " H(ELP)"
5080 PRINT " Q(UIT)"
5090 PRINT ""
5100 INPUT "PRESS ENTER: ";X$
5110 HOME
5120 RETURN
5125 REM
8000 REM YOU WON
8010 HOME
8020 PRINT "YOU WON!"
8030 PRINT ""
8040 PRINT "FINAL SCORE: ";SC
8050 PRINT ""
8060 PRINT "THANKS FOR"
8070 PRINT "PLAYING!"
8080 PRINT ""
8090 INPUT "PLAY AGAIN? ";X$
8100 IF LEFT$ (X$, 1) = "Y" THEN ST = 1: GOTO 45
8110 RETURN
8115 REM
8120 REM YOU LOST / QUIT
8130 HOME
8140 PRINT "GAME OVER"
8150 PRINT ""
8160 PRINT "THANKS FOR"
8170 PRINT "PLAYING!"
8180 END
